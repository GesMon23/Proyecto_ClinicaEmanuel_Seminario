# ====== APP ======
NODE_ENV=production
PORT=3001
APP_BASE_URL=https://clinicaemanuel.com.gt

# (Opcional) Si tu backend soporta una lista de orígenes CORS:
# CORS_ORIGIN=https://clinicaemanuel.com.gt,https://www.clinicaemanuel.com.gt

# ====== AUTH / JWT ======
JWT_SECRET=CHANGE_ME

# ====== MAIL (SendGrid API recomendado) ======
MAIL_PROVIDER=sendgrid
MAIL_API_KEY=YOUR_SENDGRID_API_KEY   # <- NO pongas la clave real aquí
MAIL_FROM="Clínica Emanuel <no-reply@clinicamanuel.com.gt>"
ADMIN_EMAIL=soporte.clinicaemanuel@gmail.com

# ====== SMTP (fallback opcional, si no usas API) ======
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=YOUR_SMTP_PASSWORD        # <- placeholder

# ====== POSTGRES ======
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=seminario
PGPASSWORD=CHANGE_ME
PGDATABASE=seminarioclinic
DATABASE_URL=postgres://seminario:CHANGE_ME@127.0.0.1:5432/seminarioclinic

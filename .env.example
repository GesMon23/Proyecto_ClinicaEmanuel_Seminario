# Configuración de un entorno para docker compose. Copiar a .env (nunca se versiona) y completar.
# Cada entorno (local, preproducción, producción) tiene su propio .env con secretos distintos.

# ---- Imágenes ----
# Etiqueta publicada por el CI (SHA del commit). En local se deja "local" y se construye con --build.
ETIQUETA=local
# IMAGEN_PREFIJO=ghcr.io/gesmon23/proyecto_clinicaemanuel_seminario

# ---- Acceso ----
# Local: 8080. Servidores: 127.0.0.1:8080 (solo Caddy expone 80/443)
PUERTO_HTTP=8080
# Solo servidores (perfil tls): pre.clinicaemanuel.com.gt / clinicaemanuel.com.gt
DOMINIO=
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# ---- Base de datos (el contenedor db se crea con estos datos) ----
PGDATABASE=db_clinica
PGUSER=clinica
PGPASSWORD=
PGSSLMODE=disable

# ---- Seguridad ----
# Generar uno distinto por entorno, p. ej.: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Orígenes externos permitidos además del propio dominio (separados por coma; admite *.dominio)
CORS_ORIGENES=

# ---- Correo (recuperación de contraseña) ----
# En preproducción usar un buzón de pruebas para no escribir a usuarios reales
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
